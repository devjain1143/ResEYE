# ─────────────────────────────────────────────
# Telegram Bot Configuration
# ─────────────────────────────────────────────

# Get this from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram user ID (get it from @userinfobot)
# This is the ADMIN who can see bot logs/errors
ADMIN_ID=your_telegram_user_id_here

# ─────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────

# Path to the Excel file for data import
EXCEL_FILE_PATH=./data/students.xlsx

# Path to the Registration Excel file
REGISTRATION_FILE_PATH=./registration_data.xlsx

# Path to the SQLite database
DB_PATH=./data/students.db

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────

# Max queries per user per minute
RATE_LIMIT=10
