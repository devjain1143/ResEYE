{
  "name": "reseye",
  "version": "1.0.0",
  "description": "ResEYE - Academic Intelligence & Surveillance Tape Archive",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "import": "node scripts/import_excel.js",
    "test": "node scripts/security_test.js",
    "test:security": "node scripts/security_test.js",
    "test:ai": "node scripts/test_prompt.js",
    "lint:emoji": "node scripts/check-no-emojis.js",
    "verify:encryption": "node scripts/verify-no-plaintext.js",
    "build": "npm install && npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@getbrevo/brevo": "^2.2.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
